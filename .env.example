# Required authentication settings
ACCESS_KEY=replace-with-a-long-random-editor-key
VIEW_KEY=replace-with-a-different-random-viewer-key
AUTH_SECRET=replace-with-at-least-32-random-bytes
SOCKET_AUTH_SECRET=replace-with-another-32-random-bytes

# Public source-code link shown on the sign-in page
NEXT_PUBLIC_SOURCE_URL=https://github.com/malithedeveloper/obsdraw

# Local persistence (default)
LOCAL_STORE_DIR=./server-data
BOARD_NAME=anonymous

# Reverse proxy settings
TRUST_PROXY=0
# ALLOWED_ORIGINS=https://draw.example.com

# Optional Cloudflare R2 persistence (preferred for Heroku)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_HISTORY_PREFIX=boards
# R2_MEDIA_PREFIX=media

# Optional WebDAV persistence (used when R2 is not configured)
# WEBDAV_URL=
# WEBDAV_USERNAME=
# WEBDAV_PASSWORD=
# WEBDAV_BASE_PATH=/obsdraw
# WEBDAV_BACKUPS=0

# Optional media controls
# MEDIA_MAX_FILE_BYTES=52428800
# MEDIA_MAX_INPUT_PIXELS=40000000
# MEDIA_COMPRESS=0
# MEDIA_COMPRESS_FORMAT=webp
# MEDIA_COMPRESS_QUALITY=82
# MEDIA_PROXY_MAX_BYTES=52428800
# MEDIA_PROXY_ALLOW_HOSTS=media.example.com,cdn.example.com
# MEDIA_PROXY_ALLOW_PORTS=80,443

# Optional server tuning
# MAX_HISTORY=5000
# PERSIST_FLUSH_MS=1500
# PERSIST_FLUSH_EVENTS=100
# SOCKET_MAX_MESSAGE_BYTES=65536
# SOCKET_RATE_LIMIT_MESSAGES=1500
# SOCKET_RATE_LIMIT_BYTES=8388608
# SOCKET_RATE_LIMIT_WINDOW_MS=10000
# SOCKET_MAX_CONNECTIONS_PER_IP=12
# LOGIN_RATE_LIMIT_ATTEMPTS=20
# LOGIN_RATE_LIMIT_WINDOW_MS=600000
